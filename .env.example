# Copy to .env for local development. .env is gitignored; never commit real
# values. On Netlify these are set under Site configuration -> Environment
# variables.

# Project URL and the *anon* (publishable) key, from
# Supabase Dashboard -> Project Settings -> API.
# The anon key is designed to be public: row-level security limits it to
# published notes, and writes require a signed-in admin session.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The site's own address, used for absolute URLs in the RSS feed.
# Netlify injects URL automatically; this is only for local runs.
SITE_URL=http://localhost:4321
